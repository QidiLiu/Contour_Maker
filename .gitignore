# ---------------------------------------------------------------- python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------------------------------------------------------------- data (large, re-downloadable)
data/raw/
data/interim/
data/unified/
data/splits/
data/yolo_det/
data/yolo_seg/
data/roi_cache/

# ---------------------------------------------------------------- 训练产物
# runs/ 权重不入库（体积大）；models/ 只保留转换后的 .mnn 作为交付物
runs/
logs/
*.pt
*.pth
*.onnx
*.onnx.data
# 例外：ultralytics 预训练基座权重（首次训练必需，官方源下载不稳定）
!weights/*.pt
!models/*.mnn

# ---------------------------------------------------------------- C++ build
build/
cmake-build-*/
*.o
*.a
*.so
compile_commands.json

# ---------------------------------------------------------------- third party
third_party/

# ---------------------------------------------------------------- misc
.DS_Store
*.log
# 验证产物
reports/
logs/
